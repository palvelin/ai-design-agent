@INCOLLECTION{D-Ambrosio2014-ku,
  title     = "{HyperNEAT}: The first five years",
  author    = "D'Ambrosio, David B and Gauci, Jason and Stanley, Kenneth O",
  booktitle = "Studies in Computational Intelligence",
  publisher = "Springer Berlin Heidelberg",
  address   = "Berlin, Heidelberg",
  pages     = "159--185",
  abstract  = "HyperNEAT, which stands for Hypercube-based NeuroEvolution of
               Augmenting Topologies, is a method for evolving
               indirectly-encoded artificial neural networks (ANNs) that was
               first introduced in 2007. By exploiting a unique indirect
               encoding called Compositional Pattern Producing Networks (CPPNs)
               that does not require a typical developmental stage, HyperNEAT
               introduced several novel capabilities to the field of
               neuroevolution (i.e. evolving artificial neural networks). Among
               these, (1) large ANNs can be compactly encoded by small genomes,
               (2) the size and resolution of evolved ANNs can scale up or down
               even after training is completed, and (3) neural structure can be
               evolved to exploit problem geometry. Five years after its
               introduction, researchers have leveraged these capabilities to
               produce a broad range of successful experiments and extensions
               that highlight the potential for future research to build further
               on the ideas introduced by HyperNEAT. This chapter reviews these
               first 5 years of research that builds upon this approach, and
               culminates with thoughts on promising future directions.",
  series    = "Studies in computational intelligence",
  year      =  2014,
  url       = "http://dx.doi.org/10.1007/978-3-642-55337-0_5",
  doi       = "10.1007/978-3-642-55337-0\_5",
  isbn      = "9783642553363,9783642553370",
  language  = "en"
}

@INPROCEEDINGS{Takala1988-wi,
  title     = "Industrial Design Based on Geometric Intentions",
  author    = "Takala, Tapio and Woodward, Charles D",
  booktitle = "Theoretical Foundations of Computer Graphics and CAD",
  publisher = "Springer Berlin Heidelberg",
  pages     = "953--963",
  abstract  = "We present a theoretical framework for organizing the interactive
               computer aided design process. It is based on design
               transactions, which describe how the design proceeds from a
               preliminary sketch (geometric intentions) into an exact product
               model. The framework can also be used as a guideline for the
               implementation of CAD systems. Based on the theory, requirements
               for geometric modeling systems in industrial design with
