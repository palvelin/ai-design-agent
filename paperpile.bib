@ARTICLE{Braun2006-ib,
  title     = "Using thematic analysis in psychology",
  author    = "Braun, Virginia and Clarke, Victoria",
  journal   = "Qualitative research in psychology",
  publisher = "Routledge",
  volume    =  3,
  number    =  2,
  pages     = "77--101",
  abstract  = "Thematic analysis is a poorly demarcated, rarely acknowledged,
               yet widely used qualitative analytic method within psychology. In
               this paper, we argue that it offers an accessible and
               theoretically flexible approach to analysing qualitative data. We
