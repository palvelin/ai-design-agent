@ARTICLE{Narayanan2018-cz,
  title     = "Automatic machine knitting of {3D} meshes",
  author    = "Narayanan, Vidya and Albaugh, Lea and Hodgins, Jessica and Coros,
               Stelian and Mccann, James",
  journal   = "ACM Transactions on Graphics",
  publisher = "Association for Computing Machinery (ACM)",
  volume    =  37,
  number    =  3,
  pages     = "1--15",
  abstract  = "We present the first computational approach that can transform
               three-dimensional (3D) meshes, created by traditional modeling
               programs, directly into instructions for a computer-controlled
               knitting machine. Knitting machines are able to robustly and
               repeatably form knitted 3D surfaces from yarn but have many
               constraints on what they can fabricate. Given user-defined
               starting and ending points on an input mesh, our system
               incrementally builds a helix-free, quad-dominant mesh with
               uniform edge lengths, runs a tracing procedure over this mesh to
               generate a knitting path, and schedules the knitting instructions
               for this path in a way that is compatible with machine
