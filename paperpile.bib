}

@ARTICLE{Muratovski2020-tp,
  title    = "The Making of an American Design School: Lessons Learned",
  author   = "Muratovski, Gjoko",
  journal  = "She Ji: The Journal of Design, Economics, and Innovation",
  volume   =  6,
  number   =  1,
  pages    = "67--82",
  abstract = "Throughout the modern history of design there were many design
              schools that tried to shape the field in one way or another. While
              some were experimental, others were grounded and had a very
              practical focus. Very few of these early-day mavericks survived
              the test of time, remained true to their original mission, and
