@INCOLLECTION{Pauwels2015-jp,
  title     = "Conversation and critique within the architectural design
               process: A linkograph analysis",
  author    = "Pauwels, Pieter and Strobbe, Tiemen and Derboven, Jeroen and De
               Meyer, Ronald",
  booktitle = "Design Computing and Cognition '14",
  publisher = "Springer International Publishing",
  address   = "Cham",
  pages     = "135--152",
  abstract  = "Conversation and critique are central to architectural design
               practice as they function as tools for probing and further
               improving design ideas. We study the kind of design activities
               that take place in such conversation and critique within the
               architectural design process. We use linkographs to characterise
               the design process taking place during conversation. More
               precisely, we study conversations between design teachers and
               design students. In this article, an example design process is
               considered that takes place via a traditional face-to-face
               meeting. Using the resulting linkograph, we are able to assess
               the kind of design activity taking place during such sessions of
               conversation and critique.",
  year      =  2015,
  url       = "https://link.springer.com/chapter/10.1007/978-3-319-14956-1_8",
  doi       = "10.1007/978-3-319-14956-1\_8",
  isbn      = "9783319149554,9783319149561",
  language  = "en"
}

@INCOLLECTION{Higuchi2020-lu,
