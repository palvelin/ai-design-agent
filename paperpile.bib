@INCOLLECTION{Higuchi2016-ez,
  title     = "Creativity effects of idea-marathon system ({IMS}): Torrance
               tests of creative thinking ({TTCT}) figural tests for college
               students",
  author    = "Higuchi, Takeo and Yuizono, Takaya and Miyata, Kazunori and
