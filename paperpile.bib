@INCOLLECTION{Milovanovic2022-uy,
  title     = "Exploring the use of digital tools to support design studio
               pedagogy through studying collaboration and cognition",
  author    = "Milovanovic, Julie and Gero, John S",
  booktitle = "Design Computing and Cognition’20",
  publisher = "Springer International Publishing",
  address   = "Cham",
  pages     = "21--39",
  abstract  = "This paper explores the effect of the use of digital design
               representation tools to support design studio pedagogy. We
               present the results of a case study of three types of
               architectural design critiques also called design reviews. The
               first one is a traditional desk critique where common design
               representations (plans, section, mock-ups) were used by tutors
               and students. The second case study investigates the use of a
               social Virtual Reality device, the Hyve-3D, that supports design
               collaboration through an immersive 3D sketch interface. The third
               case study involves the use of a digital desk utilizing the
               Sketsha interface to support remote design studio critiques. We
               used a video protocol analysis to study two characteristics of
               the design critiques: design collaboration and participants’
               interactions with design representations. Results highlight
               behavioral trends for each type of critique and provide insights
               on the potential of digital design representations to support
               design studio pedagogy.",
  year      =  2022,
