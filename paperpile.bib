@ARTICLE{Hatchuel2011-if,
  title     = "Teaching innovative design reasoning: How concept–knowledge
               theory can help overcome fixation effects",
  author    = "Hatchuel, Armand and Le Masson, Pascal and Weil, Benoit",
  journal   = "Artificial intelligence for engineering design, analysis and
