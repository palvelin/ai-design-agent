@ARTICLE{Kavakli1998-oz,
  title    = "Structure in idea sketching behaviour",
  author   = "Kavakli, Manolya and Scrivener, Stephen A R and Ball, Linden J",
  journal  = "Design Studies",
  volume   =  19,
  number   =  4,
  pages    = "485--517",
  abstract = "This paper describes a study designed to investigate the structure
              of idea sketches, here defined as the initial free-hand drawn
