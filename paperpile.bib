  url      = "http://dx.doi.org/10.1177/23969873221079413",
  doi      = "10.1177/23969873221079413",
  language = "en"
}

@ARTICLE{Corazza2023-yi,
  title     = "Beyond the adjacent possible: On the irreducibility of human
