@ARTICLE{Parker2015-jo,
  title     = "Establishing the first mobile stroke unit in the United States",
  author    = "Parker, Stephanie A and Bowry, Ritvij and Wu, Tzu-Ching and
               Noser, Elizabeth A and Jackson, Kamilah and Richardson, Laura and
               Persse, David and Grotta, James C",
