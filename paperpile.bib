@ARTICLE{Liu2017-vl,
  title    = "Visualizing High-Dimensional Data: Advances in the Past Decade",
  author   = "Liu, Shusen and Maljovec, Dan and Wang, Bei and Bremer, Peer-Timo
              and Pascucci, Valerio",
