@INCOLLECTION{Khan2021-xa,
  title     = "Supporting Expensive Physical Models With Geometric Moment
               Invariants to Accelerate Sensitivity Analysis for Shape
               Optimisation",
  author    = "Khan, Shahroz and Kaklis, Panagiotis and Serani, Andrea and Diez,
