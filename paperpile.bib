@ARTICLE{noauthor_undated-ln,
  title    = "{IHTE} Tehtäväanalyysi harjoitustyö",
  abstract = "Harjoitustyön aiheena on käytännön tehtäväanalyysin toteuttaminen,
              joka sisältää kahden käyttäjän haastattelun ja tulosten
              analysointia. Kurssi tarjoaa valmiita harjoitustyöaiheita tai
              aiheen voi saada omasta työstään. Harjoitustyö tehdään pareittain
              tai poikkeustapauksessa yksin. Tuloksista kirjoitetaan raportti
              näiden ohjeiden mukaan. Harjoitustyöstä tehdään suunnitelma, joka
              palautetaan Moodleen 21.4. klo 12 mennessä. Tulokset sisältävä
              raportti on palautettava Moodlen kautta 13.5. klo 12 mennessä.
              Myöhästyneistä suunnitelmasta tai loppuraportista arvosana alenee
              yhden numeron per myöhästynyt vuorokausi. Eli 13.5. klo 12.02
              palautetusta loppuraportista alenee arvosana yhden numeron ja
              14.5. klo 12.02 kaksi numeroa. Parityönä tehty suunnitelma ja
              tulosraportti kirjoitetaan yhdessä ja kumpikin palauttaa ne
              Moodleen. Raportit hylätään, jos ne eivät noudata rakenteeltaan
              näitä ohjeita"
}

