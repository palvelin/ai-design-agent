@INPROCEEDINGS{Herbst2021-rc,
  title     = "Scan-Driven Fully-Automated Pipeline for a Personalized, {3D}
               Printed Low-Cost Prosthetic Hand",
  author    = "Herbst, Yair and Polinsky, Shunit and Fischer, Anath and Medan,
