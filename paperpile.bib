  url       = "https://www.google.com/books?hl=fi&lr=&id=owrIDgAAQBAJ&oi=fnd&pg=PP2&dq=The+Handbook+of+Multimodal-Multisensor+Interfaces,+Volume+1:+&ots=CSqe9mkhWQ&sig=SLTSpFdD3iATv43ztqi8-NmXcv8",
