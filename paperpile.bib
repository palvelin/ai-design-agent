@ARTICLE{Walter2022-ie,
  title    = "European Stroke Organisation ({ESO}) guidelines on mobile stroke
              units for prehospital stroke management",
  author   = "Walter, Silke and Audebert, Heinrich J and Katsanos, Aristeidis H
