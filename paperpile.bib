@ARTICLE{Bourdot2010-tv,
  title    = "{VR–CAD} integration: Multimodal immersive interaction and
              advanced haptic paradigms for implicit edition of {CAD} models",
  author   = "Bourdot, P and Convard, T and Picon, F and Ammi, M and Touraine, D
