@INPROCEEDINGS{Ahola2022-op,
  title     = "Scaling the Magnetic Resonance Imaging Through Design Research",
  author    = "Ahola, Markus and Uusitalo, Severi and Palva, Lauri and Sepponen,
               Raimo",
  booktitle = "Human Interaction, Emerging Technologies and Future Systems V",
  publisher = "Springer International Publishing",
  pages     = "1018--1025",
  abstract  = "The superior soft-tissue contrast and sensitivity for pathologies
               have made magnetic resonance imaging (MRI) a primary modality in
               medical imaging. At present, the high initial and running costs,
               and demanding requirements for siting and operating personnel
               limit its availability to large hospitals and imaging clinics.
               Improved accessibility of MRI technology can lead into new
               healthcare services. To study this, we set up the Accessible
               Magnetic Resonance Imaging (AMRI) research platform, including a
               multidisciplinary research team and a very low field MRI device
               for evaluation of new service solutions. We explored the expected
               value of accessibility in point-of-care contexts, achieving
               validation and improved focus for initial need-descriptions for
               the solution. Our design research points towards the potential of
               a more accessible MRI in improving healthcare provision, and that
               ever-prevalent medical imaging healthcare services could cause
               systemic changes to the healthcare processes, technologies, and
               operating environments.",
  year      =  2022,
  url       = "http://dx.doi.org/10.1007/978-3-030-85540-6_130",
  doi       = "10.1007/978-3-030-85540-6\_130"
}

