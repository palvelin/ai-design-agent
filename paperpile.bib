  year          =  2019,
  url           = "http://openaccess.thecvf.com/content_CVPR_2019/html/Yin_Semantics_Disentangling_for_Text-To-Image_Generation_CVPR_2019_paper.html",
  archivePrefix = "arXiv",
  primaryClass  = "cs.CV"
}

@ARTICLE{Coenen2019-yc,
