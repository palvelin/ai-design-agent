@INPROCEEDINGS{Nagai2006-rt,
  title     = "{FORMALDESCRIPTION} {OF} {CONCEPT}-{SYNTHESIZING} {PROCESS} {FOR}
               {CREATIVE} {DESIGN}",
  author    = "Nagai, Yukari and Taura, Toshiharu",
  booktitle = "Design Computing and Cognition ’06",
  publisher = "Springer Netherlands",
  pages     = "443--460",
  abstract  = "Abstract. We describe a design synthesizing process which has
               been pointed out to be a key to creative design. We describe two
               topics of design study. First, from the perspectives of
               creativity, the conceptsynthesizing process is formed with the
               1st primitive of the conceptsynthesizing process being ‘concept
               abstraction’ with the principle of ‘similarity’ in ‘taxonomical
               relations’, the 2nd primitive being ‘concept blending,’ in which
               the principle is ‘similarity’ and ‘dissimilarity’ in ‘taxonomical
               relations’, and the 3rd primitive being ‘concept integration’ and
               with the principle of ‘thematic relations’. Second, design
               experiments using protocol analysis were conducted to identify
               what/how design primitives are related to higher creativity. As a
               result, in the process of synthesizing concepts, thematic
               relations between two concepts significantly extend the design
               space, which led to higher creativity. Given this, the creative
               design process can be driven by the 3rd primitive of the
               concept-synthesizing process.",
  year      =  2006,
  url       = "http://dx.doi.org/10.1007/978-1-4020-5131-9_23",
  doi       = "10.1007/978-1-4020-5131-9\_23"
}

